APP_ENV=development
POSTGRES_DB=kspdb
POSTGRES_USER=kspdb
POSTGRES_PASSWORD=kspdb
DATABASE_URL=postgresql://kspdb:kspdb@db:5432/kspdb
RUN_MIGRATIONS_ON_STARTUP=true
SEED_REGISTRY_ON_STARTUP=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Optional — leave blank to disable AI fault summaries
ANTHROPIC_API_KEY=
